create graph type orders {
(customerType: Customer {id int, email string, city string, zip string}),
(orderType: Order {id int, total float, customer int}),
FOR (c: customerType) EXCLUSIVE MANDATORY SINGLETON c.id,
FOR (c: customerType) EXCLUSIVE c.email,
FOR (c: customerType) MANDATORY c.zip,
FOR (o: orderType) EXCLUSIVE MANDATORY SINGLETON o.id,
FOR (o: orderType) MANDATORY c.id WITHIN (c: customerType) WHERE c.id = o.customer
}
