schemas = {SOI ~ createGraphType ~ (createGraphType)* ~ EOI}
createGraphType = {^"CREATE GRAPH TYPE" ~ graphType}
graphType = {typeName? ~ graphTypeElements}
graphTypeElements = {"{" ~ elements? ~ ","? ~ "}"}
elements = {element ~ ("," ~ element)*}
element = {nodeType | edgeType | constraint}
nodeType = {"(" ~ typeName ~ labelPropertySpec ~ ")"}
edgeType = {endpointType ~ "-" ~ middleType ~ "-" ~ ">" ~ endpointType}
middleType = {"[" ~ typeName ~ labelPropertySpec ~ "]"}
endpointType = {"(" ~ ":" ~ typeName ~ ")"}
labelPropertySpec = {":"? ~ labelSpecSet? ~ propertySpec?}
labelSpecSet = {labelSpec ~ ( and ~ labelSpec)*}
labelSpec = {"(" ~ labelSpecSet ~ ")"
            | "[" ~ labelSpecSet ~ "]"
            | label
        }
propertySpec = {"{" ~ properties? ~ "}"}
properties = {property ~ ("," ~ property)*}
property = {key ~ propertyType}
typeName = @{literal}
label = @{literal}
key = @{literal}
propertyType = @{literal}
literal = _{ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*}
and = { "&" }
constraint = { ^"FOR" ~ constraintMatch ~ constraintType+ ~ constraintElem ~ constraintWithin? ~ constraintWhere? }
constraintMatch = { nodeMatch | edgeMatch }
constraintType = { "EXCLUSIVE" | "MANDATORY" | "SINGLETON" }
constraintProp = { constraintVar ~ "." ~ key }
constraintElem = { constraintProp | constraintVar }
nodeMatch = { "(" ~ constraintVar ~ ":" ~ typeName ~")"}
edgeTypeMatch = { constraintVar ~ (":" ~ typeName ~ ( and ~ labelSpecSet )? )? }
edgeNodeMatch = {"(" ~ ( edgeTypeMatch )? ~ ")"}
edgeMatch = { edgeNodeMatch ~ "-" ~ "[" ~ edgeTypeMatch ~ "]" ~ "-" ~ ">" ~ edgeNodeMatch}
constraintWithin = { ^"WITHIN" ~ (nodeMatch | edgeMatch) }
constraintWhere = { ^"WHERE" ~ (constraintElem | constraintConstant ) ~ constraintOperator ~ (constraintElem | constraintConstant)}
constraintConstant = {ASCII_DIGIT+}
constraintOperator = { "=" | "<" | ">" }
constraintVar = @{literal}
WHITESPACE = _{" "|NEWLINE}
