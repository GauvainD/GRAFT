schemas = {SOI ~ createGraphType ~ (createGraphType)* ~ EOI}
createGraphType = {^"CREATE GRAPH TYPE" ~ graphType}
graphType = {typeName? ~ graphTypeElements}
graphTypeElements = {"{" ~ elements? ~ ","? ~ "}"}
// Types must be declared before constraints: a node match of a constraint looks like a node type.
elements = { element ~ ("," ~ element)* ~ ("," ~ constraint)* | constraint ~ ("," ~ constraint)* }
element = {nodeType | edgeType}
nodeType = {"(" ~ typeName ~ labelPropertySpec ~ ")"}
edgeType = {endpointType ~ "-" ~ middleType ~ "-" ~ ">" ~ endpointType}
middleType = {"[" ~ typeName ~ labelPropertySpec ~ "]"}
endpointType = {"(" ~ ":" ~ typeName ~ ")"}
labelPropertySpec = {":"? ~ labelSpecSet? ~ propertySpec?}
labelSpecSet = {labelSpec ~ ( and ~ labelSpec)*}
labelSpec = {"(" ~ labelSpecSet ~ ")"
            | "[" ~ labelSpecSet ~ "]"
            | label
        }
propertySpec = {"{" ~ properties? ~ "}"}
properties = {property ~ ("," ~ property)*}
property = {key ~ propertyType}
typeName = @{literal}
label = @{literal}
key = @{literal}
propertyType = @{literal}
literal = _{ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*}
and = { "&" }
// FOR <matches> [WHERE ..] <qualifiers> [<keys>] [WITHIN <matches>] [WHERE ..]
constraint = { ^"FOR" ~ constraintSide ~ constraintType+ ~ keyList? ~ (constraintWithin | constraintWhere)? }
// A constraint alone, as stored in Neo4j
singleConstraint = { SOI ~ constraint ~ EOI }
constraintSide = { matches ~ constraintWhere? }
constraintWithin = { ^"WITHIN" ~ constraintSide }
constraintWhere = { ^"WHERE" ~ conditions }
constraintType = { "EXCLUSIVE" | "MANDATORY" | "SINGLETON" | "IDENTIFIER" }
// A pattern is a conjunction of node and edge matches sharing variables
matches = { constraintMatch ~ ("," ~ constraintMatch)* }
constraintMatch = { edgeMatch | nodeMatch }
nodeMatch = { "(" ~ elemSpec? ~ ")" }
edgeMatch = { nodeMatch ~ "-" ~ "[" ~ elemSpec? ~ "]" ~ "-" ~ ">" ~ nodeMatch }
elemSpec = { constraintVar ~ elemType? | elemType }
elemType = { ":" ~ typeName ~ (and ~ labelSpecSet)? }
keyList = { constraintElem ~ ("," ~ constraintElem)* }
constraintElem = { constraintProp | constraintVar }
constraintProp = { constraintVar ~ "." ~ key }
conditions = { condition ~ (^"AND" ~ condition)* }
condition = { term ~ constraintOperator ~ term }
term = { dist | operand }
dist = { ^"DIST" ~ "(" ~ operand ~ "," ~ operand ~ ")" }
operand = { constraintConstant | constraintProp | constraintVar }
constraintConstant = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? | "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
constraintOperator = { "<=" | ">=" | "<>" | "=" | "<" | ">" }
constraintKeyword = _{ ^"FOR" | ^"WITHIN" | ^"WHERE" | ^"AND" | ^"DIST" | "EXCLUSIVE" | "MANDATORY" | "SINGLETON" | "IDENTIFIER" }
constraintVar = @{ !(constraintKeyword ~ !(ASCII_ALPHANUMERIC | "_")) ~ literal }
WHITESPACE = _{" "|NEWLINE}
